// A principal granting themselves Owner/Contributor at subscription or resource scope.
AzureActivity
| where OperationNameValue has "Microsoft.Authorization/roleAssignments/write"
| extend roleId = tostring(parse_json(Properties).requestbody.properties.roleDefinitionId)
| extend principalId = tostring(parse_json(Properties).requestbody.properties.principalId)
| where roleId has_any ("8e3af657-a8ff-443c-a75c-2fe8c4bcb635", "b24988ac-6180-42a0-ab88-20f7382dd24c") // Owner, Contributor
| where principalId == tostring(Caller)
| project TimeGenerated, Caller, roleId, principalId, Scope = _ResourceId
